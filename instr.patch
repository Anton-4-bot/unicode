+                const uoff: usize = @intCast(off);
+                var it = self.codegen.proc_registry.constIterator();
+                while (it.next()) |e| {
+                    const p = e.value_ptr.*;
+                    if (uoff >= p.code_start and uoff < p.code_end) {
+                        proc_id = e.key_ptr.*;
+                        proc_start = p.code_start;
+                        proc_stack = p.stack_alloc;
+                        break;
+                    }
+                }
+            }
+            if (self.statementAt(d.addr - 1)) |line| {
+                const name = if (line.loc.hasLocation()) self.lir_store.sourceFileName(line.loc.file) else "?";
+                std.debug.print("OVFDBG first={d} count={d} off={d} proc={d} proc_start={d} stack_alloc={d} at {s}:{d}:{d}\n", .{ d.first, d.count, off, proc_id, proc_start, proc_stack, name, line.loc.line, line.loc.column });
+            } else {
+                std.debug.print("OVFDBG first={d} count={d} off={d} proc={d} proc_start={d} stack_alloc={d} at ?\n", .{ d.first, d.count, off, proc_id, proc_start, proc_stack });
+            }
+        }
     }
 
