+        const Distinct = struct { addr: usize, count: usize, first: usize };
+        var distinct: [80]Distinct = undefined;
+        var n: usize = 0;
+        var dropped: usize = 0;
+        for (known.calls, 0..) |addr, i| {
+            var found = false;
+            for (distinct[0..n]) |*d| {
+                if (d.addr == addr) {
+                    d.count += 1;
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                if (n < distinct.len) {
+                    distinct[n] = .{ .addr = addr, .count = 1, .first = i };
+                    n += 1;
+                } else dropped += 1;
+            }
+        }
+        std.debug.print("OVFDBG distinct={d} dropped={d}\n", .{ n, dropped });
+        for (distinct[0..n]) |d| {
